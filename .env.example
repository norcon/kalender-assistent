# Kalender-Assistent – Grundeinstellungen
#
# Zugangsdaten (Postfächer, KI-Server, Kalender-Server, Benachrichtigungen)
# gehören nicht hierher: Der Einrichtungsassistent im Browser
# (http://<server>:8080) fragt sie ab, danach liegen sie verschlüsselt in der
# App und lassen sich unter Einstellungen → Verbindungen ändern (dafür
# APP_PASSWORD setzen). Wer ohne Assistent einrichten will: siehe Block ganz
# unten.

# Passwort für die Oberfläche (leer = kein Zugangsschutz, nur im Heimnetz empfohlen)
APP_PASSWORD=
# Sprache der Oberfläche: auto (Browser), de oder en
APP_LANGUAGE=auto

# Modell am KI-Server (der Einrichtungsassistent trägt es ein); auch unter Einstellungen änderbar
AI_MODEL=
IMAP_FOLDER=INBOX
CALDAV_TIMEZONE=Europe/Berlin

# Standardwerte; können in der Oberfläche unter „Einstellungen“ überschrieben werden.
IMAP_POLL_SECONDS=300
# Abruf, solange IMAP IDLE aktiv ist (neue Mails kommen dann sofort)
IMAP_IDLE_POLL_SECONDS=1800
IMAP_INITIAL_LOOKBACK_DAYS=14
IMAP_MAX_MESSAGE_BYTES=10485760
AI_TIMEOUT_SECONDS=1800
CALDAV_TIMEOUT_SECONDS=30
DEFAULT_EVENT_MINUTES=60
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
UNCERTAIN_THRESHOLD_PERCENT=60
CALENDAR_BACKUP_MINUTES=60
CALENDAR_KEEP_DAYS=30
REMINDER_MINUTES=60
ALLDAY_REMINDER_HOUR=18
LOG_LEVEL=INFO
# Newsletter: Vorschläge unter dieser KI-Sicherheit ausblenden (0 = aus)
NEWSLETTER_MIN_CONFIDENCE_PERCENT=95
# Zielkalender beim ersten Start (Komma-getrennt, exakte Kalendernamen); danach in den Einstellungen änderbar
TARGET_CALENDARS=

# Demo-Modus mit Beispieldaten, ohne Postfach/KI/Kalender
DEMO_MODE=0
# Feste Version (leer = neueste); wird vom Updater gesetzt
# KALENDER_VERSION=0.17.0
# Neue Versionen bei GitHub suchen (0 = aus)
UPDATE_CHECK=1
APP_DATABASE_PATH=/data/calendar-assistant.sqlite3

# --- Zugangsdaten von Hand (nur ohne Einrichtungsassistent) ---------------
# Auskommentieren und ausfüllen. Die App übernimmt die Werte beim nächsten
# Start verschlüsselt; der Updater entfernt sie danach wieder aus dieser Datei.
#
# Postfach (weitere Postfächer: IMAP2_* bis IMAP9_*, gleiche Felder plus FOLDER)
# IMAP_HOST=imap.example.org
# IMAP_PORT=993
# IMAP_USERNAME=
# IMAP_PASSWORD=
# IMAP_NAME=
#
# OpenAI-kompatibler KI-Server (vom Container aus erreichbare Adresse)
# AI_BASE_URL=http://host.docker.internal:1234/v1
# AI_API_KEY=
#
# Kalender-Server (CalDAV): iCloud https://caldav.icloud.com (App-spezifisches
# Passwort), Nextcloud https://<host>/remote.php/dav, mailbox.org
# https://dav.mailbox.org/, Fastmail https://caldav.fastmail.com/dav/,
# Posteo https://posteo.de:8443/
# CALDAV_URL=https://caldav.icloud.com
# CALDAV_USERNAME=
# CALDAV_APP_PASSWORD=
# CALDAV_NAME=
# CALDAV_AUTH=basic   (digest für ältere Baïkal-Server)
#
# Benachrichtigungen (jeder eingetragene Kanal wird genutzt)
# APP_URL=http://192.168.1.10:8080
# NTFY_URL=https://ntfy.sh/mein-geheimes-thema
# NTFY_TOKEN=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# HOMEASSISTANT_URL=
# HOMEASSISTANT_TOKEN=
# HOMEASSISTANT_SERVICE=mobile_app_mein_iphone
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls   (ssl für Port 465, none)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# NOTIFY_EMAIL_TO=
